<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: back up workouts, goals and weight log to Google and copy them on device transfer. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="personal_gym.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="personal_gym.xml" />
    </device-transfer>
</data-extraction-rules>
